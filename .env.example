# Thames Water Credentials
THAMES_WATER_EMAIL=your-email@example.com
THAMES_WATER_PASSWORD=your-password

# API Authentication
THAMES_WATER_API_KEY=generate-a-secure-key

# Alert Configuration
SPIKE_THRESHOLD=800
NOTIFICATION_EMAIL=your-notification-email@example.com
SERVICE_URL=http://localhost:8096

# Service Configuration
PORT=8096
LOG_LEVEL=info
DB_PATH=/app/data/thames_water.db

# Optional: SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional: Gmail MCP for notifications
GMAIL_MCP_ENABLED=false

# Scheduler Configuration (optional)
DAILY_FETCH_HOUR=6
DAILY_FETCH_MINUTE=0
WEEKLY_VERIFY_DAY=sun
WEEKLY_VERIFY_HOUR=7

# Scraper Configuration (optional)
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=30
