# API Authentication
THAMES_WATER_API_KEY=
INGEST_API_KEY=

# Alert Configuration
SPIKE_THRESHOLD=800
NOTIFICATION_EMAIL=gavin@slaters.uk.com

# Service Configuration
PORT=8096
LOG_LEVEL=info
DB_PATH=/app/data/thames_water.db

# Optional: SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional: Gmail MCP for notifications
GMAIL_MCP_ENABLED=false

# Scheduler Configuration (optional)
WEEKLY_VERIFY_DAY=sun
WEEKLY_VERIFY_HOUR=7

