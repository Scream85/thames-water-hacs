{
  "config": {
    "step": {
      "user": {
        "title": "Thames Water account",
        "description": "Sign in with your Thames Water online account (the account must have a smart meter).",
        "data": { "email": "[%key:common::config_flow::data::email%]", "password": "[%key:common::config_flow::data::password%]" }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Thames Water",
        "data": { "password": "[%key:common::config_flow::data::password%]" }
      }
    },
    "error": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "no_meter": "No smart meter was found on this account.",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "wrong_account": "Those credentials belong to a different Thames Water account",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Thames Water options",
        "data": { "spike_threshold": "Daily spike threshold (litres)" }
      }
    }
  },
  "entity": {
    "sensor": {
      "latest_day_usage": { "name": "Latest day usage" },
      "average_7d": { "name": "7-day average usage" },
      "month_to_date": { "name": "Month-to-date usage" },
      "meter_reading": { "name": "Meter reading" },
      "min_hourly_usage": { "name": "Minimum hourly usage" },
      "latest_day_usage_m3": { "name": "Latest day usage (m³)" },
      "average_7d_m3": { "name": "7-day average usage (m³)" },
      "month_to_date_m3": { "name": "Month-to-date usage (m³)" },
      "meter_reading_m3": { "name": "Meter reading (m³)" },
      "min_hourly_usage_m3": { "name": "Minimum hourly usage (m³)" },
      "last_data": { "name": "Last data" },
      "latest_day_cost": { "name": "Latest day cost" },
      "month_to_date_cost": { "name": "Month-to-date cost" },
      "clean_water_rate": { "name": "Clean water rate" },
      "wastewater_rate": { "name": "Wastewater rate" },
      "combined_water_rate": { "name": "Combined water rate" }
    },
    "binary_sensor": {
      "usage_spike": { "name": "Usage spike" }
    }
  }
}
